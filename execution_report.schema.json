{
    "$defs": {
        "Address": {
            "additionalProperties": false,
            "description": "The name of the physical location where the computation took place.",
            "properties": {
                "addressCountry": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "addressLocality": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "addressRegion": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "postalCode": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Address",
            "type": "object"
        },
        "Location": {
            "additionalProperties": false,
            "description": "Physical location where the computer was. Don't really care more than city/country.",
            "properties": {
                "address": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Address"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Location",
            "type": "object"
        },
        "Provider": {
            "additionalProperties": false,
            "description": "Infrastructure provider.",
            "properties": {
                "infra_identifier": {
                    "description": "Unique identifier for this infrastructure.\n",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "infra_name": {
                    "description": "Name of the infrastructure (who should get credit).\n",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "infra_version": {
                    "description": "For software-based infrastructure: the version.\n",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Provider",
            "type": "object"
        },
        "Report": {
            "additionalProperties": false,
            "description": "Tool execution report. Gives credit for the specific execution of a data analysis tool.",
            "properties": {
                "affiliation": {
                    "description": "Identifier of the project associated with this tool execution. Ideally from the Research Organization Registry (ROR) https://ror.org/.\n",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "cpu_cores_assigned": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "cpu_cores_used": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "cpu_identifier": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "cpu_mods": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "duration": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "end_time": {
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "final_outputs_size_bytes": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "gpu_cores_used": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "infra": {
                    "items": {
                        "$ref": "#/$defs/Provider"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "input_size_bytes": {
                    "description": "The total size of the inputs in bytes, MUST be (rounded or binned, details TBD).\n",
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "location": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Location"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Physical location of the computer where the tool was run\n"
                },
                "memory_used": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "report_format_version": {
                    "description": "The version of the execution schema used.\n",
                    "pattern": "0.0.2",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "start_time": {
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "tool": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Tool"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "title": "Report",
            "type": "object"
        },
        "Tool": {
            "additionalProperties": false,
            "description": "The data analysis tool that was executed, for which this tool execution report was generated about.",
            "properties": {
                "identifier": {
                    "description": "Tool identifier from bio.tools, an RRID, or other source. Multiple identifiers can be supplied for tools known to multiple registries\n",
                    "items": {
                        "format": "uri",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "name": {
                    "description": "What the tool author calls the tool.\n",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "package_version": {
                    "description": "Galaxy wrapper version string as reported by the Galaxy API (e.g. \"0.74+galaxy1\").\nIdentifies the specific Galaxy wrapper used; useful for support and debugging but\ndistinct from the tool's own version.\n",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "version": {
                    "description": "Version of the tool that was actually run, taken from the primary conda package\nrequirement in the Galaxy toolshed wrapper XML (e.g. \"0.12.1\" for FastQC, \"1.5.1\"\nfor Salmon). This is NOT the Galaxy wrapper version, which can differ substantially\n(e.g. FastQC wrapper \"0.74+galaxy1\" wraps conda package \"0.12.1\").\n",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Tool",
            "type": "object"
        }
    },
    "$id": "https://elixir-europe.org/platforms/compute/execution_report.linkml.yaml",
